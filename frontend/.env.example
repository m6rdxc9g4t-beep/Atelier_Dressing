# Mode « Synchronisé » (Mac ↔ iPhone, IA Claude) : renseigne ton projet Supabase.
# Sans ces deux valeurs, l'app fonctionne en mode « Sur cet appareil » (données
# et photos stockées dans le navigateur ou l'app Mac, IA Ollama en local).
# Copie ce fichier en .env.local.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Adresse publique de l'app web (liens des e-mails de confirmation, y compris depuis l'app Mac)
VITE_APP_URL=
